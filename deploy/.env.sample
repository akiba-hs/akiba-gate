# ---------------------------------------------------------------------------
# akiba-gate — все переменные окружения с тестовыми значениями.
#
# Значения здесь ненастоящие: их хватает, чтобы шлюз стартовал и показал
# портал, но ни один сервис по ним не отзовётся. Перед боевым запуском
# заменить всё, что помечено ОБЯЗАТЕЛЬНО.
# ---------------------------------------------------------------------------

# --- Авторизация -----------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Публичный ключ auth-service в формате PEM — им проверяется
# подпись токена. Приватного ключа у шлюза нет и быть не должно.
# Вместо ключа целиком можно указать путь: JWT_PUBLIC_KEY_PATH=/data/jwt.pem
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nТЕСТОВЫЙ_КЛЮЧ_ЗАМЕНИТЬ\n-----END PUBLIC KEY-----"
JWT_PUBLIC_KEY_PATH=

# ОБЯЗАТЕЛЬНО. Адрес сервиса входа через Telegram.
AUTH_URL=https://auth.example.org

# ОБЯЗАТЕЛЬНО. Адрес портала, каким его видит браузер резидента. Из него
# строятся ссылка возврата после входа, адрес Jellyfin для localStorage и
# эталон Origin для запросов к qBittorrent — ошибка здесь ломает всё три.
PUBLIC_BASE_URL=https://inside.example.org

# Имена, под которыми портал считается своим, через запятую. Нужны, когда к
# нему ходят по нескольким адресам: незнакомое имя тихо ломает автовход.
ALLOWED_HOSTS=inside.example.org

# Куда auth-service возвращает после входа. Пусто — на PUBLIC_BASE_URL.
# Задаётся, только если тот содержит порт: адрес с портом auth-service
# отвергает.
AUTH_RETURN_BASE_URL=

# Имя куки с токеном. Должно совпадать с тем, что ставит auth-service.
AUTH_COOKIE_NAME=token

# Пускать только тех, кто состоит в чате резидентов.
REQUIRE_RESIDENT=true

# --- Jellyfin --------------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Адрес Jellyfin внутри сети, куда проксирует шлюз.
JELLYFIN_INTERNAL_URL=http://jellyfin:8096

# Префикс, под которым Jellyfin виден снаружи через шлюз.
JELLYFIN_BASE_PATH=/jellyfin

# ОБЯЗАТЕЛЬНО. Служебная учётка Jellyfin: ею шлюз подтверждает коды быстрого
# подключения. Права администратора ей не нужны.
JELLYFIN_USER=akiba-gate
JELLYFIN_PASSWORD=тестовый-пароль-заменить

# --- Nextcloud -------------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Адрес Nextcloud, каким его видит браузер резидента.
NEXTCLOUD_PUBLIC_URL=https://nextcloud.example.org

# ОБЯЗАТЕЛЬНО. Общий секрет с приложением akibasso внутри Nextcloud, не
# короче 32 символов. Генерируется так: openssl rand -base64 32
NEXTCLOUD_SSO_SECRET=ТЕСТОВЫЙ-СЕКРЕТ-ЗАМЕНИТЬ-НЕ-МЕНЕЕ-32-СИМВОЛОВ

# Путь приложения-адаптера внутри Nextcloud.
NEXTCLOUD_SSO_PATH=/index.php/apps/akibasso/login

# Привязывать одноразовый код к адресу браузера. Выключить, если резиденты
# приходят к шлюзу и к Nextcloud разными путями (NAT, VPN): тогда адреса не
# совпадут и вход будет отказывать всегда.
NEXTCLOUD_SSO_BIND_IP=true

# --- qBittorrent -----------------------------------------------------------

# ОБЯЗАТЕЛЬНО. Адрес qBittorrent внутри сети.
QBITTORRENT_INTERNAL_URL=http://qbittorrent:8080

# Префикс, под которым qBittorrent виден снаружи через шлюз.
QBITTORRENT_BASE_PATH=/qbittorrent

# session — шлюз держит служебную сессию (по умолчанию);
# bypass — qBittorrent пускает по whitelist подсети шлюза.
QBITTORRENT_AUTH_MODE=session

# ОБЯЗАТЕЛЬНО в режиме session.
QBITTORRENT_USER=akiba-gate
QBITTORRENT_PASSWORD=тестовый-пароль-заменить

# --- Права и состояние -----------------------------------------------------

# ОБЯЗАТЕЛЬНО. Telegram-ID первого администратора: ему доступно всё и всегда,
# мимо базы. Иначе раздать права было бы некому.
ADMIN_TELEGRAM_ID=100000000

# Файл SQLite с резидентами и их правами. Каталог должен быть на запись.
DB_PATH=/data/akiba-gate/gate.db

# --- Сообщения в чат (необязательно) ---------------------------------------

# Бот сообщает в чат, кто поставил торрент на закачку. Без обоих значений
# шлюз работает молча.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Прокси для выхода в Telegram: через него идут аватарки и сообщения бота.
# Пусто — напрямую.
SOCKS5_PROXY=
SOCKS5_USER=
SOCKS5_PASSWORD=

# --- Прочее ----------------------------------------------------------------

# Адрес и порт, которые слушает шлюз.
LISTEN_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# Таймаут запросов шлюза к сервисам.
HTTP_TIMEOUT=15s

# Файл с текстами интерфейса. Правится без пересборки: шлюз перечитывает его,
# если тот изменился, но не чаще раза в I18N_TTL.
I18N_PATH=/data/akiba-gate/i18n/i18n.ru.json
I18N_TTL=1m
