# ---------------------------------------------------------------------------
# akiba-gate — пример окружения. Скопируйте в .env и заполните.
# Ни одно значение не имеет «безопасного» умолчания: сервис не стартует,
# пока конфигурация не заполнена целиком.
# ---------------------------------------------------------------------------

# --- Авторизация -----------------------------------------------------------
# Публичный ключ auth-service. Приватный ключ шлюзу НЕ НУЖЕН.
# Получить: openssl rsa -in <JWT_KEY с central.akiba.space> -pubout
# Переносы строк можно записать как \n.
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----
# Либо путь к файлу вместо переменной выше:
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

AUTH_URL=https://auth.akiba.space
# Адрес, по которому портал открывают в браузере, — ровно как в адресной
# строке, вместе с портом, если он нестандартный. Из него строятся ссылка
# возврата после входа, адрес Jellyfin для localStorage и эталон Origin для
# qBittorrent; при расхождении автовход и добавление торрентов отказывают
# молча. Учтите при этом, что auth-service проверяет redirect_uri как
# netloc.endswith('.akiba.space'), а netloc включает порт: адрес с портом он
# отвергает с 400, поэтому вход работает только на 80 и 443.
PUBLIC_BASE_URL=https://inside.akiba.space

# Дополнительные имена, под которыми портал считается своим, через запятую.
# Пусто по умолчанию. Пригождается, когда портал открывают не по одному
# каноническому адресу: по имени из запроса строится адрес Jellyfin для
# localStorage и проверяется Origin запросов к qBittorrent, поэтому под
# незнакомым именем автовход и добавление торрентов отказывают молча.
# ALLOWED_HOSTS=inside.akiba.space:8080,192.168.8.82

# Куда auth-service возвращает после входа, если это должен быть не
# PUBLIC_BASE_URL. Пусто по умолчанию — и в норме менять не нужно.
# Существует ради ограничения auth-service, описанного выше: пока портал
# висит на нестандартном порту, вход возможен только с возвратом по адресу
# без порта. Путь исходного запроса при этом теряется — вернуться к нужному
# разделу придётся вручную.
#
# Указывайте здесь СВОЁ имя портала без порта, если по нему до шлюза можно
# достучаться: тогда auth-service отдаёт 303 прямо на главную, и никакой
# промежуточной страницы «вы вошли» человек не видит. Имя обязано быть и в
# ALLOWED_HOSTS. Адрес чужого сайта (например, https://auth.akiba.space)
# — крайний случай: вход состоится, но человек останется на той странице, а
# портал в соседней вкладке дождётся куки опросом /whoami и обновится сам.
# AUTH_RETURN_BASE_URL=http://inside.akiba.space

# Имя куки, которую ставит auth-service. Менять не нужно.
AUTH_COOKIE_NAME=token
# false — пускать всех, кто вошёл через Telegram, даже не резидентов.
REQUIRE_RESIDENT=true

# --- Jellyfin --------------------------------------------------------------
JELLYFIN_INTERNAL_URL=http://192.168.8.43:8096
# Публичный префикс, под которым шлюз отдаёт Jellyfin. Настройку «Base URL»
# в самом Jellyfin менять НЕ нужно: префикс снимает шлюз, а прямой доступ
# по адресу из JELLYFIN_INTERNAL_URL остаётся прежним.
JELLYFIN_BASE_PATH=/jellyfin
# Общая учётка резидентов (по требованиям — одна на всех).
JELLYFIN_USER=residents
JELLYFIN_PASSWORD=

# --- Nextcloud -------------------------------------------------------------
# Адрес Nextcloud, каким его видит браузер резидента.
NEXTCLOUD_PUBLIC_URL=https://nextcloud.akiba.space

# Вход устроен так: шлюз выдаёт одноразовый код и отправляет браузер в
# приложение-адаптер внутри Nextcloud, а тот обменивает код на личность
# запросом к шлюзу и логинит человека средствами самого Nextcloud.
#
# Пароля шлюз не знает и не хранит. Поэтому резидент волен задать и менять
# себе пароль в Nextcloud как угодно — на вход через портал это не влияет.
#
# Приложение и инструкция по установке: deploy/nextcloud-app/.
#
# Общий секрет с приложением. Обязателен, не короче 32 символов.
# Сгенерировать: openssl rand -base64 32
# Тот же секрет прописывается в приложении:
#   occ config:app:set akibasso shared_secret --value="<секрет>"
NEXTCLOUD_SSO_SECRET=

# Путь приложения-адаптера. Менять нужно, только если приложение переименовано.
# NEXTCLOUD_SSO_PATH=/index.php/apps/akibasso/login

# Привязывать ли одноразовый код к адресу браузера. true по умолчанию: без
# неё перехваченный код можно предъявить из другого места. Выключайте, только
# если шлюз и Nextcloud видят клиента под разными адресами (NAT между ними) —
# симптом такой: вход стабильно отказывает, а в журнале шлюза
# «обмен кода Nextcloud отклонён».
# NEXTCLOUD_SSO_BIND_IP=true

# --- qBittorrent -----------------------------------------------------------
QBITTORRENT_INTERNAL_URL=http://192.168.8.43:8081
QBITTORRENT_BASE_PATH=/qbittorrent
# session — шлюз логинится сам и подставляет cookie (qBittorrent остаётся под паролем);
# bypass  — вход отключён для подсети шлюза в настройках qBittorrent.
QBITTORRENT_AUTH_MODE=session
QBITTORRENT_USER=akiba-gate
QBITTORRENT_PASSWORD=

# --- Управление доступом ---------------------------------------------------
# Telegram-ID изначального администратора. Ему всегда доступны все сервисы,
# включая админку, и снять с него доступ нельзя ничем, кроме правки этой
# строки: иначе назначенный им второй администратор мог бы запереть первого
# снаружи собственной системы.
#
# Узнать свой ID: написать боту @userinfobot.
#
# Всем остальным по умолчанию не доступно НИЧЕГО. Резидент появляется в
# админке после первого входа на портал, и доступ ему открывают галочками.
ADMIN_TELEGRAM_ID=

# --- Состояние и уведомления -----------------------------------------------
# База шлюза. Хранит список резидентов и выданные им права на сервисы.
# Ни паролей, ни истории добавленных торрентов в ней нет: пароли перестали
# быть механизмом входа, а историю ведёт бот в групповом чате.
DB_PATH=/var/lib/akiba-gate/gate.db

# Бот. Делает три вещи:
#   - сообщает в групповой чат о новых торрентах (нужны оба значения ниже);
#   - пишет добавившему в личку, когда загрузка закончилась (достаточно
#     токена: адресат берётся из токена авторизации, чат не нужен);
#   - при открытии админки сверяет список резидентов с составом чата и
#     убирает выбывших (нужны оба значения).
#
# Личное сообщение дойдёт только до того, кто хоть раз нажимал Start в диалоге
# с ботом: начинать разговор первым Telegram ботам запрещает. Отказ попадает
# в журнал и ни на что больше не влияет.
#
# Включается наличием обоих значений — отдельного флага нет намеренно: он
# позволял бы включить бота с пустым токеном и потом искать причину молчания.
# Если чего-то нет, шлюз работает как прежде и один раз при старте пишет в
# журнал, почему уведомлений не будет.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Тексты интерфейса ------------------------------------------------------
# Все надписи портала и шаблон сообщения бота лежат в этом файле и правятся
# без пересборки. Шлюз держит их в памяти и проверяет, изменился ли файл, не
# чаще раза в I18N_TTL. Файл должен быть доступен на запись: испорченный JSON
# шлюз чинит, записывая обратно последние корректные тексты.
I18N_PATH=/etc/akiba-gate/i18n.ru.json
I18N_TTL=1m

# --- Выход в Telegram -------------------------------------------------------
# Один прокси на весь Telegram: через него идут и аватарки резидентов (t.me),
# и сообщения бота (api.telegram.org). Других выходов в Telegram у шлюза нет.
#
# Пустое значение — прямой выход, и тогда меняется ещё одно: портал ставит в
# <img> прямую ссылку на t.me вместо своего /userpic/. Прослойка нужна ровно
# там, где t.me недоступен; при открытом доступе она только добавляла бы
# лишнее звено. Сам маршрут /userpic/ остаётся и остаётся закрытым Guard.
# SOCKS5_PROXY=127.0.0.1:1080
# SOCKS5_USER=
# SOCKS5_PASSWORD=

# --- Прочее ----------------------------------------------------------------
LISTEN_ADDR=:8080
LOG_LEVEL=info
HTTP_TIMEOUT=15s
